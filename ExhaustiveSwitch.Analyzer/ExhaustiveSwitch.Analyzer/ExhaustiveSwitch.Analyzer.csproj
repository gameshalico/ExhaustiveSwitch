<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>8</LangVersion>
        <RootNamespace>ExhaustiveSwitch.Analyzer</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.3.0" />
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
      <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Resources\Resources.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      </EmbeddedResource>
      <EmbeddedResource Update="Resources\Resources.ja.resx">
        <Generator>ResXFileCodeGenerator</Generator>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Resources\Resources.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
      </Compile>
    </ItemGroup>

    <Target Name="CopyToUnity" AfterTargets="Build">
        <PropertyGroup>
            <UnityAnalyzerPath>$(ProjectDir)..\..\ExhaustiveSwitch\Assets\ExhaustiveSwitch\Analyzer</UnityAnalyzerPath>
        </PropertyGroup>

        <!-- メインDLLのコピー -->
        <ItemGroup>
            <MainDll Include="$(OutputPath)$(AssemblyName).dll" />
            <JaResourcesDll Include="$(OutputPath)ja\$(AssemblyName).resources.dll" />
        </ItemGroup>

        <Copy SourceFiles="@(MainDll)"
              DestinationFolder="$(UnityAnalyzerPath)"
              SkipUnchangedFiles="true" />

        <!-- 日本語リソースのコピー -->
        <Copy SourceFiles="@(JaResourcesDll)"
              DestinationFolder="$(UnityAnalyzerPath)\ja"
              SkipUnchangedFiles="true"
              Condition="Exists('$(OutputPath)ja\$(AssemblyName).resources.dll')" />

        <Message Text="Copied $(AssemblyName).dll to Unity Analyzer folder" Importance="high" />
    </Target>

</Project>
